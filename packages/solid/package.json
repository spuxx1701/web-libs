{
  "name": "@spuxx/solid",
  "version": "2.0.2",
  "description": "A package containing various utilities for my Solid applications.",
  "license": "MIT",
  "author": {
    "name": "spuxx",
    "email": "hi@spuxx.dev",
    "url": "https://spuxx.dev"
  },
  "keywords": [
    "spuxx"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/spuxx-dev/jslibs"
  },
  "homepage": "https://github.com/spuxx-dev/jslibs/blob/main/packages/solid/README.md",
  "bugs": {
    "url": "https://github.com/spuxx-dev/jslibs/issues"
  },
  "type": "module",
  "main": "dist/main.js",
  "module": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./server": {
      "types": "./dist/main.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "dev": "concurrently \"cd ../browser-utils && npm run dev\" \"vite build --watch\"",
    "build": "vite build && vite build --mode server",
    "types": "tsc --noEmit",
    "test": "pnpm test:vitest",
    "test:vitest": "playwright install --with-deps && vitest --browser.headless",
    "test:vitest:browser": "playwright install --with-deps && vitest",
    "test:vitest:watch": "playwright install --with-deps && vitest --inspect --no-file-parallelism --watch"
  },
  "devDependencies": {
    "@solidjs/testing-library": "0.8.10",
    "@spuxx/browser-utils": "workspace:@spuxx/browser-utils@*",
    "@testing-library/jest-dom": "6.9.1",
    "@vitest/browser": "5.0.0",
    "@vitest/browser-playwright": "5.0.0",
    "@vitest/coverage-istanbul": "5.0.0",
    "iconify-icon": "3.0.2",
    "solid-js": "1.9.13",
    "typescript": "6.0.3",
    "unplugin-dts": "1.0.3",
    "vite": "8.2.0",
    "vite-plugin-solid": "2.11.12",
    "vitest": "5.0.0",
    "playwright": "1.63.0"
  },
  "peerDependencies": {
    "@spuxx/browser-utils": "workspace:@spuxx/browser-utils@*",
    "@spuxx/js-utils": "^1.3.0",
    "iconify-icon": "^2.3.0",
    "solid-js": "^1.9.0"
  },
  "dependencies": {
    "@corvu/accordion": "0.2.5",
    "@corvu/dialog": "0.2.4",
    "@corvu/drawer": "0.2.4"
  }
}
